FROM golang:1.25-alpine AS build
WORKDIR /src
COPY apps/mcp-go/go.mod apps/mcp-go/go.sum ./
RUN go mod download
COPY apps/mcp-go/ .
RUN CGO_ENABLED=0 go build -trimpath -o /mcp .

# Tag :debug inclui um busybox (shell + wget) p/ o HEALTHCHECK do compose,
# sem deixar de ser distroless (sem gerenciador de pacotes, roda non-root).
FROM gcr.io/distroless/static-debian12:debug
COPY --from=build /mcp /mcp
COPY docs/openapi.yaml /openapi.yaml
ENV OPENAPI_PATH=/openapi.yaml
EXPOSE 3335
USER nonroot:nonroot
ENTRYPOINT ["/mcp"]
