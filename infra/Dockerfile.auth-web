FROM oven/bun:1 AS builder
WORKDIR /app/apps/auth-web

COPY apps/auth-web/package.json .
RUN bun install

COPY apps/auth-web .

ARG VITE_API_URL=https://api.santos-tech.com
ARG VITE_REDIRECT_DEFAULT=https://santos-tech.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REDIRECT_DEFAULT=$VITE_REDIRECT_DEFAULT

RUN bun run build

FROM nginx:alpine
COPY --from=builder /app/apps/auth-web/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
