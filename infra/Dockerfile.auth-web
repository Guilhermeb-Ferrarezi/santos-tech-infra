FROM oven/bun:1 AS builder
WORKDIR /app/apps/auth-web

COPY apps/auth-web/package.json .
RUN bun install

COPY apps/auth-web .

ARG VITE_API_URL=https://api.santos-tech.com
ARG VITE_REDIRECT_DEFAULT=https://santos-tech.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REDIRECT_DEFAULT=$VITE_REDIRECT_DEFAULT

RUN bun run build

# Imagem oficial nginx non-root (UID 101): já escuta em 8080 e traz pid + diretórios
# temp em caminhos graváveis pelo usuário sem privilégio. NÃO usar `USER root` nem
# `nginx -t` aqui: rodar como root no build cria /tmp/nginx.pid com dono root, que o
# runtime (uid 101) não consegue sobrescrever (foi o que causou o crash anterior).
# O conf.d já é gravável pelo uid 101. Porta interna (8080) roteada pelo orquestrador.
FROM nginxinc/nginx-unprivileged:alpine
COPY --from=builder /app/apps/auth-web/dist /usr/share/nginx/html
RUN printf '%s\n' \
      'server {' \
      '  listen 8080;' \
      '  server_name _;' \
      '  root /usr/share/nginx/html;' \
      '  index index.html;' \
      '  add_header X-Content-Type-Options "nosniff" always;' \
      '  add_header X-Frame-Options "DENY" always;' \
      '  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;' \
      "  add_header Content-Security-Policy \"default-src 'self'\" always;" \
      '  location / {' \
      '    try_files $uri $uri/ /index.html;' \
      '  }' \
      '}' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
