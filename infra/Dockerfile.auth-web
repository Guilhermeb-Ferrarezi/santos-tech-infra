FROM oven/bun:1 AS builder
WORKDIR /app/apps/auth-web

COPY apps/auth-web/package.json .
RUN bun install

COPY apps/auth-web .

ARG VITE_API_URL=https://api.santos-tech.com
ARG VITE_REDIRECT_DEFAULT=https://santos-tech.com
# Sem este ARG o Vite não enxerga a env do build e initSentry() (src/lib/sentry.ts)
# vira no-op: a tela de login rodava sem telemetria de erro nenhuma, pagando o
# custo do @sentry/react no bundle à toa. Vazio por padrão = no-op silencioso
# (dev/preview), igual ao comportamento documentado no .env.example.
ARG VITE_SENTRY_DSN=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REDIRECT_DEFAULT=$VITE_REDIRECT_DEFAULT
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

RUN bun run build

FROM nginx:alpine
COPY --from=builder /app/apps/auth-web/dist /usr/share/nginx/html

# SPA + headers de segurança em todas as respostas. nginx roda como root no master
# (workers caem para o usuário `nginx` automaticamente), igual ao comportamento
# original. O non-root completo do master fica para um passo futuro com a imagem
# nginxinc/nginx-unprivileged, validado com `docker run` (não só `docker build`).
#
# CSP: FONTE ÚNICA (apps/auth-web/Dockerfile + nginx.conf, que serviam a mesma
# app SEM header de segurança nenhum, foram removidos). Notas de cada diretiva:
#   style-src 'unsafe-inline' — AuthLayout.tsx:9 e BrandPanel.tsx:5 usam
#     style={{background: linear-gradient(...)}}, e o Radix injeta estilo inline
#     em runtime. Sem style-src a diretiva caía no default-src 'self' e os
#     gradientes da tela de login eram BLOQUEADOS em produção.
#   img-src cdn.santos-tech.com — avatares (oauth-choose.tsx:93,
#     switch-account.tsx:76, confirm.tsx:88) vêm do R2/CDN (ver
#     handlers_avatar.go: a URL gravada em users.avatar_url é a pública do R2).
#   connect-src *.ingest*.sentry.io — destino do @sentry/react agora que o DSN
#     chega ao build.
#   base-uri / form-action / frame-ancestors — NÃO são cobertos por default-src;
#     sem eles um <base> ou <form action> injetado escapa da política.
RUN set -eux; \
    printf '%s\n' \
      'server {' \
      '  listen 80;' \
      '  server_name _;' \
      '  root /usr/share/nginx/html;' \
      '  index index.html;' \
      '  add_header X-Content-Type-Options "nosniff" always;' \
      '  add_header X-Frame-Options "DENY" always;' \
      '  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;' \
      "  add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; connect-src 'self' https://api.santos-tech.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; img-src 'self' data: https://cdn.santos-tech.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'none'; form-action 'self' https://api.santos-tech.com; frame-ancestors 'none'\" always;" \
      '  location / {' \
      '    try_files $uri $uri/ /index.html;' \
      '  }' \
      '}' > /etc/nginx/conf.d/default.conf; \
    nginx -t

EXPOSE 80
