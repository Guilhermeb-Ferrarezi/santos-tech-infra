FROM oven/bun:1 AS builder
WORKDIR /app/apps/pay-web

COPY apps/pay-web/package.json .
RUN bun install

COPY apps/pay-web .

ARG VITE_API_URL=https://api.santos-tech.com/payments
ARG VITE_AUTH_URL=https://auth.santos-tech.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL

RUN bun run build

FROM nginx:alpine
COPY --from=builder /app/apps/pay-web/dist /usr/share/nginx/html

# SPA + headers de segurança em todas as respostas. nginx roda como root no master
# (workers caem para o usuário `nginx` automaticamente), igual ao comportamento
# original. O non-root completo do master fica para um passo futuro com a imagem
# nginxinc/nginx-unprivileged, validado com `docker run` (não só `docker build`).
RUN set -eux; \
    printf '%s\n' \
      'server {' \
      '  listen 80;' \
      '  server_name _;' \
      '  root /usr/share/nginx/html;' \
      '  index index.html;' \
      '  add_header X-Content-Type-Options "nosniff" always;' \
      '  add_header X-Frame-Options "DENY" always;' \
      '  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;' \
      "  add_header Content-Security-Policy \"default-src 'self'; connect-src 'self' https://api.santos-tech.com https://auth.santos-tech.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:\" always;" \
      '  location / {' \
      '    try_files $uri $uri/ /index.html;' \
      '  }' \
      '}' > /etc/nginx/conf.d/default.conf; \
    nginx -t

EXPOSE 80
