FROM oven/bun:1 AS builder
WORKDIR /app/apps/pay-web

COPY apps/pay-web/package.json .
RUN bun install

COPY apps/pay-web .

ARG VITE_API_URL=https://api.santos-tech.com/payments
ARG VITE_AUTH_URL=https://auth.santos-tech.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL

RUN bun run build

FROM nginx:alpine
COPY --from=builder /app/apps/pay-web/dist /usr/share/nginx/html

# nginx non-root: escuta em 8080 (porta não-privilegiada), grava o pid em /tmp e
# os diretórios de cache pertencem ao usuário `nginx`. Headers de segurança em
# todas as respostas. `try_files` mantém o roteamento SPA.
RUN set -eux; \
    printf '%s\n' \
      'server {' \
      '  listen 8080;' \
      '  server_name _;' \
      '  root /usr/share/nginx/html;' \
      '  index index.html;' \
      '  add_header X-Content-Type-Options "nosniff" always;' \
      '  add_header X-Frame-Options "DENY" always;' \
      '  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;' \
      "  add_header Content-Security-Policy \"default-src 'self'\" always;" \
      '  location / {' \
      '    try_files $uri $uri/ /index.html;' \
      '  }' \
      '}' > /etc/nginx/conf.d/default.conf; \
    # pid em local gravável pelo usuário nginx
    sed -i 's@pid .*;@pid /tmp/nginx.pid;@' /etc/nginx/nginx.conf; \
    # diretórios de cache/temp/log graváveis pelo usuário nginx (logs são symlink p/ stdout/stderr)
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d; \
    nginx -t -c /etc/nginx/nginx.conf

USER nginx
EXPOSE 8080
