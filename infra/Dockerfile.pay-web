FROM oven/bun:1 AS builder
WORKDIR /app/apps/pay-web

COPY apps/pay-web/package.json .
RUN bun install

COPY apps/pay-web .

ARG VITE_API_URL=https://api.santos-tech.com/payments
ARG VITE_AUTH_URL=https://auth.santos-tech.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL

RUN bun run build

FROM nginx:alpine
COPY --from=builder /app/apps/pay-web/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
