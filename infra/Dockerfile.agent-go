# Imagem do orquestrador do Claude. NÃO é distroless: precisa de shell + node + git
# para rodar o `claude` CLI, os MCP servers (npx) e clonar repositórios.
FROM golang:1.25-alpine AS build
WORKDIR /src
# Pacote de log compartilhado, resolvido pelo `replace ../../packages/golog`.
COPY packages/golog ./packages/golog
COPY apps/agent-go/go.mod apps/agent-go/go.sum ./apps/agent-go/
WORKDIR /src/apps/agent-go
RUN go mod download
COPY apps/agent-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /agent-go .

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates ripgrep curl \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code \
 && useradd -m -u 1001 agent \
 && mkdir -p /data/workspaces /home/agent/.claude \
 && chown -R agent:agent /data /home/agent/.claude
COPY --from=build /agent-go /usr/local/bin/agent-go
COPY infra/entrypoint-agent-go.sh /usr/local/bin/entrypoint-agent-go.sh
RUN chmod +x /usr/local/bin/entrypoint-agent-go.sh
USER agent
ENV HOME=/home/agent \
    CLAUDE_WORKSPACE_ROOT=/data/workspaces
EXPOSE 3334
ENTRYPOINT ["entrypoint-agent-go.sh"]
