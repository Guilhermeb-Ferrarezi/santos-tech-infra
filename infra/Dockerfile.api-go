FROM golang:1.25-alpine AS build
WORKDIR /src
# Pacote compartilhado (resolvido via `replace ../../packages/golog` no go.mod).
COPY packages/golog ./packages/golog
COPY apps/api-go/go.mod apps/api-go/go.sum ./apps/api-go/
WORKDIR /src/apps/api-go
RUN go mod download
COPY apps/api-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /auth .

# Tag :debug inclui um busybox (shell + wget) p/ o HEALTHCHECK do compose,
# sem deixar de ser distroless (sem gerenciador de pacotes, roda non-root).
FROM gcr.io/distroless/static-debian12:debug
COPY --from=build /auth /auth
EXPOSE 3000
USER nonroot:nonroot
ENTRYPOINT ["/auth"]
