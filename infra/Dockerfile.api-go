FROM golang:1.25-alpine AS build
WORKDIR /src
COPY apps/api-go/go.mod apps/api-go/go.sum ./
RUN go mod download
COPY apps/api-go/ .
RUN CGO_ENABLED=0 go build -trimpath -o /auth .

FROM gcr.io/distroless/static-debian12
COPY --from=build /auth /auth
EXPOSE 3000
USER nonroot:nonroot
ENTRYPOINT ["/auth"]
