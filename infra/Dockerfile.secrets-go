FROM golang:1.25-alpine AS build
WORKDIR /src
# Pacote compartilhado (replace local ../../packages/golog no go.mod do serviço).
COPY packages/golog ./packages/golog
COPY apps/secrets-go/go.mod apps/secrets-go/go.sum ./apps/secrets-go/
WORKDIR /src/apps/secrets-go
RUN go mod download
COPY apps/secrets-go/ .
RUN CGO_ENABLED=0 go build -trimpath -o /secrets .

# Tag :debug inclui um busybox (shell + wget) p/ o HEALTHCHECK do compose,
# sem deixar de ser distroless (sem gerenciador de pacotes, roda non-root).
FROM gcr.io/distroless/static-debian12:debug
COPY --from=build /secrets /secrets
EXPOSE 3338
USER nonroot:nonroot
ENTRYPOINT ["/secrets"]
