PORT=3338
DATABASE_URL=postgres://postgres:senha@localhost:5432/santos_tech?sslmode=disable
# Defina como "false" quando o DATABASE_URL apontar para PgBouncer em transaction mode
# (desliga prepared statements nomeados). Padrão: prepared statements normais (conexão direta).
DB_PREPARED_STATEMENTS=
JWT_SECRET=trocar-igual-ao-ecossistema
CORS_ORIGIN=
# Token(s) do GitHub usados pelo crawler (Search API + Contents API) — precisa
# de acesso de leitura a repositórios públicos. Prefira GITHUB_TOKENS (CSV) com
# vários PATs: cada um vira um bucket de rate limit independente, então mais
# tokens = mais throughput real e fallback automático quando um deles bate no
# limite (403/429) — o crawler segue nos outros em vez de travar esperando.
GITHUB_TOKENS=
# Compat: se GITHUB_TOKENS estiver vazio, cai pra este único token.
GITHUB_TOKEN=
# Elasticsearch onde os hits são indexados (índice "dotfy-hits").
ELASTICSEARCH_URL=http://localhost:9200
# Caminho do arquivo de estado (keywords, progresso do scan). Em produção
# (Coolify) aponta pra um volume montado, senão o progresso se perde a cada deploy.
STATE_FILE=/data/state.json
# Opcional: só usada pelo ban global por IP (ipBanCheck), mesmo namespace
# "global:ip-ban:<ip>" dos outros serviços Go. Sem ela, o check fica fail-open.
REDIS_URL=
NODE_ENV=development
# Segredo compartilhado com o Roteador de APIs (api-go) pro sync automático de
# chaves. O api-go chama /internal/sync-hits com esse valor no header
# x-sync-token (tempo constante). Vazio = endpoint desabilitado (503).
INTERNAL_SYNC_TOKEN=
