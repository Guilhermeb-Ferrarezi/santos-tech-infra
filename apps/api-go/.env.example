PORT=3000
NODE_ENV=production

# Postgres (mesmo banco do auth atual)
DATABASE_URL=postgres://postgres:senha@host:5432/santos-tech?sslmode=disable
REDIS_URL=redis://default:senha@host:6379

# Defina como "false" SOMENTE atrás de PgBouncer em transaction mode (sem prepared
# statements nomeados). Em conexão direta ao Postgres, deixe sem setar (default).
# DB_PREPARED_STATEMENTS=false

# JWT — MESMOS segredos do auth atual (tokens/cookies compatíveis)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookies compartilhados entre subdomínios
COOKIE_DOMAIN=.santos-tech.com
CORS_ORIGIN=https://app.santos-tech.com,https://mails.santos-tech.com
AUTH_WEB_ORIGIN=https://app.santos-tech.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://auth.santos-tech.com/auth/google/callback

# Emails (reset, MFA) via NOSSA API de emails (não Resend)
EMAIL_API_URL=https://mails.santos-tech.com/api
EMAIL_API_KEY=

# Cloudflare R2 (uploads de avatar). Vazio = upload desabilitado (503).
# Endpoint S3: https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET_NAME=santos-tech
# Domínio público do bucket (R2 → bucket → Settings → Custom Domains)
CF_R2_PUBLIC_URL=https://cdn.santos-tech.com

# Roteador de chaves de API (failover automático em 401/sem-créditos). Deriva a
# chave AES-256 que cifra as chaves de terceiros antes de persistir. Vazio =
# feature desabilitada (endpoints /auth/admin/api-router/* respondem 503).
# Gere com `openssl rand -base64 32`; trocar o valor invalida as chaves já salvas.
API_VAULT_SECRET=

# Sync automático do roteador com o scanner de secrets vazados (secrets-go):
# importa periodicamente os hits confirmados ativos como chaves de failover,
# criando o provider por provedor quando ainda não existe. Habilitado só com
# SECRETS_SYNC_TOKEN E API_VAULT_SECRET setados.
# SECRETS_SYNC_URL=            # base do secrets-go (ex: https://api.santos-tech.com/secrets)
# SECRETS_SYNC_TOKEN=          # mesmo valor de INTERNAL_SYNC_TOKEN no secrets-go
# SECRETS_SYNC_INTERVAL=1h     # padrão: 1h

# Web Push (notificações do navegador — nova tarefa, novo email). Vazio =
# endpoints /auth/push/* respondem 503. Gere o par com
# `npx web-push generate-vapid-keys`; trocar invalida as subscriptions salvas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@santos-tech.com

# Segredo compartilhado do webhook POST /webhooks/email/new (chamado pelo
# docker-mailserver via Sieve pipe, ver repo email/). Vazio = webhook sempre
# rejeita (fail-closed). Gere com `openssl rand -hex 32`.
EMAIL_WEBHOOK_SECRET=

# Arquivos (pastas admin vinculadas ao Google Drive). JSON da service account
# (Console GCP → IAM → Service Accounts → chave JSON), em base64 de uma linha
# só (`base64 -w0 service-account.json`). Vazio = /drive-folders responde 503.
# O admin compartilha cada pasta manualmente com o e-mail da service account
# direto no Google Drive — o dashboard nunca vê credencial de usuário final.
GOOGLE_DRIVE_SA_JSON_B64=
