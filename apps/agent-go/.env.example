PORT=3334
NODE_ENV=production

# Postgres (mesmo banco do ecossistema — tabela users compartilhada)
DATABASE_URL=postgres://postgres:senha@host:5432/santos-tech?sslmode=disable
REDIS_URL=redis://default:senha@host:6379

# JWT — MESMO secret do auth central (valida tokens dos usuários)
JWT_SECRET=

# Origens permitidas (CSV) para CORS + checagem de Origin no WebSocket
CORS_ORIGIN=https://app.santos-tech.com

# Cifragem em repouso do token OAuth do Claude (qualquer string longa)
ENCRYPTION_KEY=

# Runtime do Claude
CLAUDE_BIN=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_WORKSPACE_ROOT=/data/workspaces

# GitHub (usado pelo MCP e pelo git clone dos repos)
GITHUB_TOKEN=
# Opcional: sobrescrever o comando do MCP do GitHub
# GITHUB_MCP_COMMAND=npx
# GITHUB_MCP_ARGS=-y,@modelcontextprotocol/server-github

# Tokens de infra disponibilizados ao AGENTE (ele usa via bash/curl)
EASYPANEL_URL=https://cloud.santos-tech.com
EASYPANEL_TOKEN=
CLOUDFLARE_API_TOKEN=
