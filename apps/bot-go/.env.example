PORT=3000
BASE_PATH=
DATABASE_URL=postgres://postgres:senha@localhost:5432/santos_tech?sslmode=disable
# Defina como "false" quando o DATABASE_URL apontar para PgBouncer em transaction mode
# (desliga prepared statements nomeados). Padrão: prepared statements normais (conexão direta).
DB_PREPARED_STATEMENTS=
REDIS_URL=redis://default:senha@localhost:6379
TENANT_ID=

# Meta Cloud API (WhatsApp)
# OBRIGATÓRIO: sem ele o HMAC do webhook não pode ser verificado e o serviço
# recusa iniciar (fail-closed — o payload é quem define o remetente).
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Agent-go (LLM)
AGENT_GO_URL=https://api.santos-tech.com
AGENT_GO_SECRET=

# Site oficial (sitemap.xml)
SITE_URL=https://santos-tech.com

# Notion — agendamento de aulas experimentais
NOTION_TOKEN=
NOTION_EXPERIMENTAL_AGENDA_DS_ID=37ef7f42-1ce5-8044-bcd2-000b3efd7f76

# Evolution API — captura de leads (webhook)
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Notificações admin (E.164, ex: 5516991445664)
ADMIN_WHATSAPP_NUMBER=

# Pool de processamento em background dos webhooks (Meta, Evolution, Coolify).
# BG_POOL_SLOTS = teto de tarefas simultâneas; BG_SHUTDOWN_TIMEOUT_SEC = quanto
# o processo espera as tarefas em voo terminarem no deploy antes de desistir.
BG_POOL_SLOTS=32
BG_SHUTDOWN_TIMEOUT_SEC=20

# Worker (outbox / follow-up)
OUTBOX_BATCH_SIZE=50
OUTBOX_IDLE_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=5
# Lease do claim no outbox: por quanto tempo um evento drenado fica reservado
# para a réplica que o pegou. Deve ser maior que o pior tempo de processamento.
OUTBOX_CLAIM_LEASE_SEC=300
FOLLOW_UP_CONCURRENCY=5

# Redis Stream de retries de webhook
RETRY_STREAM_KEY=bot-go:webhook-retries
RETRY_STREAM_GROUP=bot-go-retry-workers
RETRY_STREAM_CONSUMER=
RETRY_POLL_INTERVAL_SEC=300

# Cache do debounce_ms por tenant (Redis)
DEBOUNCE_CACHE_TTL_SEC=30

# Follow-up templates Meta (fora da janela 24h)
FOLLOW_UP_HAS_APPROVED_TEMPLATES=false
FOLLOW_UP_TEMPLATE_NAME=
FOLLOW_UP_TEMPLATE_LANGUAGE=pt_BR

NODE_ENV=development

# LGPD — captura de payload nos logs de acesso (golog).
# MANTENHA 0. Com 1, o corpo de /webhooks/whatsapp e /api/conversations/* vai
# para o Loki em claro: text.body, from, wa_id e profile.name não são redigidos
# (o golog redige por nome de chave e nenhum desses casa). O Dockerfile já
# define LOG_BODIES=0; esta env existe para o ambiente local e para deixar
# explícito no painel de deploy.
LOG_BODIES=0

# Rate limit do caminho de entrada (token bucket no Redis, vale entre réplicas).
# Cada mensagem recebida vira uma chamada ao LLM. Fail-open: Redis fora = passa.
RATE_LIMIT_ENABLED=true
RATE_PHONE_BURST=10
RATE_PHONE_PER_MIN=10
RATE_GLOBAL_BURST=120
RATE_GLOBAL_PER_MIN=120
# Teto DURO de chamadas ao LLM por dia (UTC). 0 desliga o teto.
LLM_DAILY_MAX=5000

# Dashboard
# DASH_API_KEY é opcional e serve só a integrações server-to-server. O painel
# autentica por cookie de sessão (access_token) validado no auth central.
DASH_API_KEY=
DASH_CORS_ORIGIN=https://santos-tech.com

# Auth central — validação da sessão de admin do painel (/bot/api/* e WebSocket).
# Fail-closed: se AUTH_ME_URL não responder, a sessão é recusada.
AUTH_ME_URL=https://api.santos-tech.com/auth/me
AUTH_TIMEOUT_MS=3000
AUTH_CACHE_TTL_SEC=60

# Coolify — webhook de falha de deploy + comandos de operação (/status, /redeploy, /logs)
# Vazio = /webhooks/coolify recusa TUDO (fail-closed). Preencha para habilitar.
COOLIFY_WEBHOOK_SECRET=
COOLIFY_API_URL=
COOLIFY_API_TOKEN=

# Sentry — poller de issues novas do ecossistema, avisa por WhatsApp (mesmo
# destinatário do notif_* acima). Vazio = poller desabilitado.
SENTRY_ORG_SLUG=
SENTRY_API_TOKEN=
SENTRY_POLL_INTERVAL_SEC=300

# Voz (STT/TTS via OpenAI)
VOICE_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1
