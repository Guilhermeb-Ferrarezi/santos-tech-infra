PORT=3336
DATABASE_URL=postgres://postgres:senha@localhost:5432/santos_tech?sslmode=disable
# Defina como "false" quando o DATABASE_URL apontar para PgBouncer em transaction mode
# (desliga prepared statements nomeados). Padrão: prepared statements normais (conexão direta).
DB_PREPARED_STATEMENTS=
REDIS_URL=redis://default:senha@localhost:6379
JWT_SECRET=trocar-igual-ao-ecossistema
EMAIL_API_URL=https://mails.santos-tech.com/api
EMAIL_API_KEY=
# Efí (gateway PIX) — homologação por default
EFI_BASE_URL=https://pix-h.api.efipay.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_P12_BASE64=
EFI_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_SECRET=
EFI_WEBHOOK_URL=https://pay.santos-tech.com/webhooks/efi
CORS_ORIGIN=
NODE_ENV=development
