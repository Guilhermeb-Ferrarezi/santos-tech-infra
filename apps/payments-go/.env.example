PORT=3336
DATABASE_URL=postgres://postgres:senha@localhost:5432/santos_tech?sslmode=disable
# Defina como "false" quando o DATABASE_URL apontar para PgBouncer em transaction mode
# (desliga prepared statements nomeados). Padrão: prepared statements normais (conexão direta).
DB_PREPARED_STATEMENTS=
REDIS_URL=redis://default:senha@localhost:6379
JWT_SECRET=trocar-igual-ao-ecossistema
EMAIL_API_URL=https://mails.santos-tech.com/api
EMAIL_API_KEY=
DOTFY_BASE_URL=https://app.dotfy.com.br
DOTFY_API_KEY=vk_test_xxx
# Secret HMAC do webhook. OBRIGATÓRIO em produção (NODE_ENV=production): sem ele o
# endpoint /webhooks/dotfy recusa todos os eventos (fail-closed) p/ evitar fraude.
DOTFY_WEBHOOK_SECRET=
# Header HTTP que carrega a assinatura do webhook (confirmar o nome real na conta Dotfy).
DOTFY_WEBHOOK_SIG_HEADER=X-Signature
CORS_ORIGIN=
NODE_ENV=development
