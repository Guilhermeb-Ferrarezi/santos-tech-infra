# Todas opcionais — defaults apontam para produção.
PORT=3335
# Raiz da API central (rotas /auth, /status, /llms.txt)
AUTH_API_URL=https://api.santos-tech.com
# /auth/me usado pelo requireAuth para VALIDAR o token de quem chama (fail-closed:
# auth central fora do ar => 401). Opcional: vazio usa AUTH_API_URL + /auth/me.
AUTH_ME_URL=
# Raiz do Claude Agent (rotas /claude/*)
CLAUDE_API_URL=https://api.santos-tech.com
# API de emails
EMAIL_API_URL=https://mails.santos-tech.com/api
# Contrato OpenAPI servido como resource (no Docker: /openapi.yaml)
OPENAPI_PATH=../../docs/openapi.yaml
NODE_ENV=development
