# ── auto-fixer ───────────────────────────────────────────────────────────────
# Copie para .env e preencha. NÃO comite o .env (já está no .gitignore).

# HTTP
PORT=3340
# Token exigido na query do webhook: POST /webhooks/coolify?token=<este valor>
COOLIFY_WEBHOOK_SECRET=troque-isto

# Redis (sidecar do compose; em produção use o serviço "redis" interno)
REDIS_URL=redis://redis:6379/0

# Coolify API (commit do deployment, logs de build, repo do app)
COOLIFY_API_URL=https://coolify.santos-tech.com
COOLIFY_API_TOKEN=

# Evolution API (notificações no grupo — reação + reply)
EVOLUTION_API_URL=https://evolution.santos-tech.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# JID do grupo de destino (termina em @g.us)
NOTIF_GROUP_JID=

# Claude Code (o fixer roda `claude` no clone)
CLAUDE_BIN=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub — auth para clone/push (usado SÓ pelo orquestrador via askpass; NUNCA é
# exposto ao processo do Claude, ver claudeEnv em claude.go).
#
# Preferencial: GitHub App instalado na conta pessoal E na org. O fixer gera um
# installation token efêmero escopado a cada repo (TTL ~1h). Cria o App em
# github.com/settings/apps (permissão Contents: Read & Write), instala nos 2 owners.
GH_APP_ID=
# Chave privada PEM do App (cole inteira; \n literais são aceitos numa linha só).
GH_APP_PRIVATE_KEY=
#
# Fallback: PAT clássico com escopo 'repo' (cobre ambos owners). Usado quando o
# App acima não está configurado. Mantenha pelo menos um dos dois.
GITHUB_TOKEN=

# Workspaces dos clones
WORKSPACE_ROOT=/data/workspaces

# Loop-guard e timeout
MAX_FIX_ATTEMPTS=2
REBUILD_TIMEOUT_MIN=15
