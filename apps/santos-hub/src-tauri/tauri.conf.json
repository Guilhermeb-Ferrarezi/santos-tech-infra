{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Santos Hub",
  "version": "0.1.3",
  "identifier": "com.santos-tech.santos-hub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Santos Hub",
        "width": 480,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.santos-tech.com https://cdn.santos-tech.com; img-src 'self' data: https://cdn.santos-tech.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OTk0M0VCRjQ5Njk1MTAKUldRUWxaYjA2ME9aNVIyc0d3R0dvZWJvRWtXaFI1V3NkRFF0Wi9pRnoyM0dmbGtDVGhHdm04c2kK",
      "endpoints": ["https://cdn.santos-tech.com/updates/santos-hub/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
