# URL base da API de pagamentos (payments-go)
VITE_API_URL=https://api.santos-tech.com/payments

# URL do auth central (redirect ao expirar sessão)
VITE_AUTH_URL=https://auth.santos-tech.com

# ── Efí / tokenização de cartão ────────────────────────────────────────────
# Identificador de Conta Efí (payee_code). Encontre em:
# app.sejaefi.com.br → API > Introdução > Identificador de Conta
# NUNCA commite o valor real — use Secrets no CI/CD.
VITE_EFI_PAYEE_CODE=

# Ambiente da Efí: "production" ou "sandbox" (padrão: sandbox)
VITE_EFI_ENV=sandbox

# DSN do projeto no Sentry (opcional — sem ela, Sentry não é inicializado)
VITE_SENTRY_DSN=
