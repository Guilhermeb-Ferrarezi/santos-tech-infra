# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/santos_tech

# MongoDB
MONGO_URL=mongodb://localhost:27017/santos_tech_logs

# JWT
JWT_SECRET=troque-por-string-longa-e-aleatoria
JWT_REFRESH_SECRET=troque-por-outra-string-longa-e-aleatoria

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# App
PORT=3000
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173
AUTH_WEB_ORIGIN=http://localhost:5174
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=noreply@santos-tech.com

# Redis
REDIS_URL=redis://localhost:6379

# OAuth (provedor) — tokens emitidos pelo /oauth/token saem com aud=<client_id>
# e scope. Com OAUTH_AUD_ENFORCE=1 esses tokens deixam de ser aceitos como
# sessão do painel (authGuard e derivados); o /oauth/userinfo continua
# funcionando. Default DESLIGADO — ligue só depois de migrar os clients OAuth
# e o app mobile que hoje usam o token do /oauth/token nas rotas normais.
OAUTH_AUD_ENFORCE=0
